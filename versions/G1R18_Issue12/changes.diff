+' Issue #12: the lower matrices do not depend on RSubdivisions, but the retained
+' original-program evidence (XOriginalCompiled) does. A cached program is reused only
+' when that evidence belongs to the current quadrature and input epoch.
+Private Function EvidenceMismatch(ByRef original As RPX_OriginalCompiledData) As String
+    If Not original.ready Then Exit Function
+    If original.subdivisions <> RSubdivisions Then
+        EvidenceMismatch = "quadrature;cached_q=" & original.subdivisions & ";q=" & RSubdivisions
+    ElseIf original.inputEpoch <> RPX_InputEpoch Then
+        EvidenceMismatch = "input_epoch;cached_epoch=" & original.inputEpoch & ";epoch=" & RPX_InputEpoch
+    End If
+End Function
 Public Function RPX_LowerExactIdentity() As String
