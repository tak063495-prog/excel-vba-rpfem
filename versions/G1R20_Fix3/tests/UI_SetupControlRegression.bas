Attribute VB_Name = "UI_SetupControlRegression"
Option Explicit
' TEST COPY ONLY. Current flags are state-machine sentinels; no solver or
' numerical field/certificate is generated by this probe.
Public Function UI_SetupCase(ByVal kind As String, ByVal nested As Boolean) As Variant
    Dim ws As Worksheet, caught As Long, src As String, msg As String
    Dim aWrite As Boolean, aBusy As Boolean, aMesh As Boolean, aResult As Boolean
    RPX_InternalWrite = nested: RPX_Busy = (kind = "busy")
    RPX_MeshCurrent = True: RPX_ResultCurrent = True
    Set ws = RPX_Sheet("要素定義")
    If kind = "protected" Then ws.Protect Password:="fix2-test-only", UserInterfaceOnly:=False
    On Error Resume Next
    Call RPX_Setup
    caught = err.Number: src = err.Source: msg = err.Description: err.Clear
    aWrite = RPX_InternalWrite: aBusy = RPX_Busy
    aMesh = RPX_MeshCurrent: aResult = RPX_ResultCurrent
    ws.Unprotect Password:="fix2-test-only"
    UI_SetupCase = Array(kind, nested, caught, src, msg, aWrite, aBusy, aMesh, aResult)
    RPX_InternalWrite = False: RPX_Busy = False
    RPX_MeshCurrent = False: RPX_ResultCurrent = False
    On Error GoTo 0
End Function
Public Function UI_PresetDoubleError(ByVal entry As Long, ByVal nested As Boolean) As Variant
    Dim ws As Worksheet, res As Worksheet, row As Long, gap As Variant
    Dim caught As Long, src As String, msg As String
    Dim aWrite As Boolean, aBusy As Boolean, aMesh As Boolean, aResult As Boolean
    Set ws = RPX_Sheet("設定"): Set res = RPX_Sheet("解析結果")
    For row = 4 To 100
        If CStr(ws.Cells(row, 4).Value2) = "GAP" Then Exit For
    Next row
    If row > 100 Then err.Raise 5, "UI_SetupControlRegression", "MISSING_GAP_PRECONDITION"
    gap = ws.Range(ws.Cells(row, 1), ws.Cells(row, 4)).Value2
    ws.Range(ws.Cells(row, 1), ws.Cells(row, 4)).ClearContents
    res.Protect Password:="fix2-test-only", UserInterfaceOnly:=False
    RPX_Busy = False: RPX_InternalWrite = nested
    RPX_MeshCurrent = True: RPX_ResultCurrent = True
    On Error Resume Next
    Select Case entry
        Case 0: Call RPX_AccuracyPreset
        Case 1: Call RPX_Speed2pctPreset
        Case 2: Call RPX_G20ImprovementPreset
    End Select
    caught = err.Number: src = err.Source: msg = err.Description: err.Clear
    aWrite = RPX_InternalWrite: aBusy = RPX_Busy
    aMesh = RPX_MeshCurrent: aResult = RPX_ResultCurrent
    res.Unprotect Password:="fix2-test-only"
    ws.Range(ws.Cells(row, 1), ws.Cells(row, 4)).Value2 = gap
    UI_PresetDoubleError = Array(entry, nested, caught, src, msg, aWrite, aBusy, aMesh, aResult)
    RPX_InternalWrite = False: RPX_Busy = False
    RPX_MeshCurrent = False: RPX_ResultCurrent = False
    On Error GoTo 0
End Function
Public Function UI_RunCase(ByVal kind As String) As Variant
    Dim ws As Worksheet, caught As Long, src As String, msg As String, priorKey As Long
    Dim aWrite As Boolean, aBusy As Boolean, aMesh As Boolean, aResult As Boolean
    Dim actualKey As Long, failNum As Long, failSource As String, failText As String
    RPX_Busy = False: RPX_InternalWrite = False
    RPX_MeshCurrent = True: RPX_ResultCurrent = True
    priorKey = Application.EnableCancelKey: Application.EnableCancelKey = xlInterrupt
    Set ws = RPX_Sheet("解析結果")
    If kind = "protected_result" Then
        ws.Protect Password:="fix2-test-only", UserInterfaceOnly:=False
    ElseIf kind = "invalid_mode" Then
        RPX_Sheet("設定").Range("B4").Value2 = "INVALID_FOR_TEST"
    Else
        err.Raise 5, "UI_SetupControlRegression", "UNKNOWN_RUN_CASE"
    End If
    On Error Resume Next
    Call RPX_Run
    caught = err.Number: src = err.Source: msg = err.Description: err.Clear
    aWrite = RPX_InternalWrite: aBusy = RPX_Busy
    aMesh = RPX_MeshCurrent: aResult = RPX_ResultCurrent
    actualKey = Application.EnableCancelKey
    failNum = RPX_LastFailureNumber: failSource = RPX_LastFailureSource: failText = RPX_LastError
    ws.Unprotect Password:="fix2-test-only"
    UI_RunCase = Array(kind, caught, src, msg, aWrite, aBusy, aMesh, aResult, actualKey, failNum, failSource, failText)
    RPX_Busy = False: RPX_InternalWrite = False
    RPX_MeshCurrent = False: RPX_ResultCurrent = False
    Application.EnableCancelKey = priorKey
    On Error GoTo 0
End Function
Public Function UI_MeshCase(ByVal kind As String) As Variant
    Dim ws As Worksheet, caught As Long, src As String, msg As String, priorKey As Long
    Dim aWrite As Boolean, aBusy As Boolean, aMesh As Boolean, aResult As Boolean
    Dim actualKey As Long, failNum As Long, failSource As String, failText As String
    RPX_Busy = False: RPX_InternalWrite = False
    RPX_MeshCurrent = True: RPX_ResultCurrent = True
    priorKey = Application.EnableCancelKey: Application.EnableCancelKey = xlInterrupt
    Select Case kind
        Case "prestart_protected_diagram"
            Set ws = RPX_Sheet("図")
            ws.Protect Password:="fix2-test-only", UserInterfaceOnly:=False
        Case "nested_protected_result"
            Set ws = RPX_Sheet("解析結果")
            ws.Protect Password:="fix2-test-only", UserInterfaceOnly:=False
            RPX_InternalWrite = True
        Case "started_protected_nodes"
            Set ws = RPX_Sheet("節点データ")
            ws.Protect Password:="fix2-test-only", UserInterfaceOnly:=False
        Case "success"
        Case Else
            err.Raise 5, "UI_SetupControlRegression", "UNKNOWN_MESH_CASE"
    End Select
    On Error Resume Next
    Call RPX_CreateMesh
    caught = err.Number: src = err.Source: msg = err.Description: err.Clear
    aWrite = RPX_InternalWrite: aBusy = RPX_Busy
    aMesh = RPX_MeshCurrent: aResult = RPX_ResultCurrent
    actualKey = Application.EnableCancelKey
    failNum = RPX_LastFailureNumber: failSource = RPX_LastFailureSource: failText = RPX_LastError
    If Not ws Is Nothing Then ws.Unprotect Password:="fix2-test-only"
    UI_MeshCase = Array(kind, caught, src, msg, aWrite, aBusy, aMesh, aResult, actualKey, failNum, failSource, failText)
    RPX_Busy = False: RPX_InternalWrite = False
    RPX_MeshCurrent = False: RPX_ResultCurrent = False
    Application.EnableCancelKey = priorKey
    On Error GoTo 0
End Function
