+Private Function HNativeDDAssembly(ByRef values() As RPX_DD) As Boolean
+    If Not RPX_NativeAvailable() Or XB < 1 Or XS < 1 Then Exit Function
+#If Win64 Then
+    Dim args(0 To 13) As LongPtr, phase As Long, cursor As Long, total As Long, n As Long, milliseconds As Long
