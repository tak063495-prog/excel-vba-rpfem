+        RPX_NativeCheckCode NGTAdd(XB, XS, XN, first, last, VarPtr(dims(0)), VarPtr(starts(0)), VarPtr(ip(0)), VarPtr(cp(0)), VarPtr(ids(0)), VarPtr(coef(0)), VarPtr(x(0)), VarPtr(answer(0)), factor)
