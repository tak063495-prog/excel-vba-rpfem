+    If LBound(XPerm) <> 0 Or UBound(XPerm) <> n - 1 Or LBound(coefAt) <> 0 Or UBound(coefAt) <> XB - 1 Or LBound(coefficients) <> 0 Then err.Raise 9, , "NATIVE_HSD_PATTERN_BUFFER"
