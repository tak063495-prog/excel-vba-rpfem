+Public Function RPX_NativeKKTCones(ByRef hh() As Double) As Boolean
+    Dim first As Long, last As Long, p As Long
+    If Not RPX_NativeAvailable() Or XB <= 0 Then Exit Function
+#If Win64 Then
+    PrepareCones True
